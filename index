<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>ABHI Nexus — Open API Portal</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0B2340;
    --navy-2:#12335C;
    --teal:#0F6E56;
    --teal-strong:#0B4F3D;
    --teal-light:#E4F4EE;
    --gold:#B08D2A;
    --gold-light:#F4EDD9;
    --bg:#F3F5F7;
    --surface:#FFFFFF;
    --ink:#131C26;
    --slate:#57626D;
    --slate-light:#8A94A0;
    --border:#DFE3E8;
    --danger:#B3261E;
    --danger-light:#FBEAE9;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Space Grotesk', sans-serif;
    letter-spacing:-0.01em;
  }
  code, .mono{
    font-family:'IBM Plex Mono', monospace;
  }
  a{color:inherit;}

  /* ---------- top nav ---------- */
  .topnav{
    position:sticky; top:0; z-index:50;
    background:var(--navy);
    color:#fff;
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 32px;
    border-bottom:3px solid var(--gold);
  }
  .brand{display:flex; align-items:center; gap:10px;}
  .brand-mark{
    width:30px;height:30px;border-radius:7px;
    background:linear-gradient(135deg, var(--teal) 0%, var(--teal-strong) 100%);
    display:flex;align-items:center;justify-content:center;
    font-family:'Space Grotesk', sans-serif; font-weight:700; font-size:15px; color:#fff;
  }
  .brand-name{font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:18px;}
  .brand-name span{color:var(--gold); font-weight:600;}
  .navtabs{display:flex; gap:4px;}
  .navtab{
    padding:9px 16px; border-radius:8px; font-size:14px; font-weight:500;
    cursor:pointer; color:#CBD6E2; border:1px solid transparent;
    transition:background .15s, color .15s;
  }
  .navtab:hover{background:rgba(255,255,255,0.06); color:#fff;}
  .navtab.active{background:rgba(255,255,255,0.1); color:#fff; border-color:rgba(255,255,255,0.12);}
  .navcta{
    background:var(--teal); color:#fff; padding:9px 16px; border-radius:8px;
    font-size:14px; font-weight:500; cursor:pointer; border:none;
    font-family:'IBM Plex Sans', sans-serif;
  }
  .navcta:hover{background:var(--teal-strong);}

  .page{display:none; max-width:1180px; margin:0 auto; padding:44px 32px 80px;}
  .page.active{display:block;}

  /* ---------- home / hero ---------- */
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.06em;
    color:var(--teal-strong); background:var(--teal-light); border-radius:20px;
    padding:5px 12px; margin-bottom:18px; text-transform:uppercase;
  }
  .hero{display:grid; grid-template-columns:1.05fr 0.95fr; gap:48px; align-items:center;}
  .hero h1{font-size:42px; font-weight:600; line-height:1.15; margin:0 0 18px; color:var(--navy);}
  .hero p.lede{font-size:16px; color:var(--slate); line-height:1.65; max-width:480px; margin:0 0 28px;}
  .hero-cta{display:flex; gap:12px;}
  .btn-primary{
    background:var(--navy); color:#fff; padding:12px 22px; border-radius:8px;
    font-size:14px; font-weight:500; border:none; cursor:pointer;
    font-family:'IBM Plex Sans', sans-serif;
  }
  .btn-primary:hover{background:var(--navy-2);}
  .btn-secondary{
    background:#fff; color:var(--navy); padding:12px 22px; border-radius:8px;
    font-size:14px; font-weight:500; border:1px solid var(--border); cursor:pointer;
    font-family:'IBM Plex Sans', sans-serif;
  }
  .btn-secondary:hover{border-color:var(--slate-light);}

  /* console */
  .console{
    background:#0C1621; border-radius:12px; padding:0; overflow:hidden;
    box-shadow:0 12px 30px rgba(11,35,64,0.18);
  }
  .console-head{
    display:flex; align-items:center; gap:8px; padding:12px 16px;
    border-bottom:1px solid rgba(255,255,255,0.08);
  }
  .dot{width:9px;height:9px;border-radius:50%;}
  .console-head .label{margin-left:8px; font-size:12px; color:#8FA0B3; font-family:'IBM Plex Mono', monospace;}
  .console-body{padding:20px; min-height:230px;}
  .console-line{font-family:'IBM Plex Mono', monospace; font-size:12.5px; line-height:1.85; white-space:pre-wrap; color:#CBD6E2;}
  .console-line .k{color:#6FD9B8;}
  .console-line .s{color:#E8C275;}
  .console-line .m{color:#7FB2E8;}
  .console-tag{
    display:inline-block; font-size:10.5px; font-family:'IBM Plex Mono', monospace;
    color:#6FD9B8; border:1px solid rgba(111,217,184,0.35); border-radius:5px;
    padding:2px 7px; margin-bottom:12px;
  }

  /* category grid */
  .section-label{
    font-family:'IBM Plex Mono', monospace; font-size:12px; letter-spacing:0.06em;
    color:var(--slate-light); text-transform:uppercase; margin:0 0 10px;
  }
  .cat-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:70px;}
  .cat-card{
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:18px; cursor:pointer; transition:border-color .15s, transform .15s;
  }
  .cat-card:hover{border-color:var(--teal); transform:translateY(-2px);}
  .cat-card .n{font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--slate-light); margin-bottom:10px;}
  .cat-card h3{font-size:15px; margin:0 0 6px; color:var(--navy);}
  .cat-card p{font-size:12.5px; color:var(--slate); margin:0; line-height:1.5;}

  .steps{display:grid; grid-template-columns:repeat(3,1fr); gap:18px; margin-top:70px;}
  .step{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px;}
  .step .num{
    font-family:'Space Grotesk', sans-serif; font-weight:600; font-size:13px; color:#fff;
    background:var(--teal); width:26px; height:26px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; margin-bottom:14px;
  }
  .step h3{font-size:15px; margin:0 0 6px; color:var(--navy);}
  .step p{font-size:13px; color:var(--slate); margin:0; line-height:1.55;}

  /* ---------- API catalog page ---------- */
  .catalog-head{display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:26px;}
  .catalog-head h2{font-size:26px; margin:0; color:var(--navy);}
  .catalog-head p{font-size:13.5px; color:var(--slate); margin:6px 0 0;}
  .search-bar{
    width:260px; padding:9px 12px; border-radius:8px; border:1px solid var(--border);
    font-size:13px; font-family:'IBM Plex Sans', sans-serif; background:#fff;
  }
  .catalog-list{display:flex; flex-direction:column; gap:10px;}
  .catalog-row{
    display:grid; grid-template-columns:110px 1fr 190px 90px; align-items:center; gap:16px;
    background:var(--surface); border:1px solid var(--border); border-radius:var(--radius);
    padding:16px 18px;
  }
  .method{
    font-family:'IBM Plex Mono', monospace; font-size:11.5px; font-weight:500;
    padding:4px 9px; border-radius:5px; text-align:center; width:fit-content;
  }
  .method.get{background:#E6F1FB; color:#0C447C;}
  .method.post{background:var(--teal-light); color:var(--teal-strong);}
  .catalog-row .path{font-family:'IBM Plex Mono', monospace; font-size:13px; color:var(--navy);}
  .catalog-row .desc{font-size:12.5px; color:var(--slate); margin-top:3px;}
  .catalog-row .cat-tag{font-size:11.5px; color:var(--slate); font-family:'IBM Plex Mono', monospace;}
  .try-link{
    font-size:12.5px; color:var(--teal-strong); font-weight:500; cursor:pointer;
    border:1px solid var(--teal); border-radius:6px; padding:6px 12px; text-align:center; background:#fff;
  }
  .try-link:hover{background:var(--teal-light);}

  /* ---------- explorer page ---------- */
  .explorer{display:grid; grid-template-columns:250px 1fr 340px; gap:0; border:1px solid var(--border); border-radius:12px; overflow:hidden; background:#fff;}
  .exp-col{padding:20px;}
  .exp-nav{background:#FAFBFC; border-right:1px solid var(--border);}
  .exp-cat{font-family:'IBM Plex Mono', monospace; font-size:11px; text-transform:uppercase; letter-spacing:0.05em; color:var(--slate-light); margin:16px 0 8px;}
  .exp-cat:first-child{margin-top:0;}
  .exp-item{
    font-size:13px; padding:8px 10px; border-radius:6px; cursor:pointer; color:var(--slate);
    display:flex; align-items:center; gap:8px;
  }
  .exp-item:hover{background:#EFF2F5;}
  .exp-item.active{background:var(--teal-light); color:var(--teal-strong); font-weight:500;}
  .exp-item .m{font-family:'IBM Plex Mono', monospace; font-size:9.5px; padding:1px 5px; border-radius:4px;}
  .exp-item .m.get{background:#E6F1FB;color:#0C447C;}
  .exp-item .m.post{background:var(--teal-light);color:var(--teal-strong);}
  .exp-main{border-right:1px solid var(--border);}
  .exp-main h3.path{font-family:'IBM Plex Mono', monospace; font-size:16px; margin:0 0 8px; color:var(--navy);}
  .exp-main p.desc{font-size:13.5px; color:var(--slate); line-height:1.6; margin:0 0 18px;}
  .exp-field-label{font-size:11.5px; color:var(--slate-light); text-transform:uppercase; letter-spacing:0.05em; font-family:'IBM Plex Mono', monospace; margin:16px 0 8px;}
  textarea#reqbody{
    width:100%; min-height:140px; border-radius:8px; border:1px solid var(--border);
    background:#FAFBFC; font-family:'IBM Plex Mono', monospace; font-size:12.5px; padding:12px;
    color:var(--ink); resize:vertical;
  }
  .run-row{display:flex; align-items:center; gap:12px; margin-top:16px;}
  .btn-run{
    background:var(--teal); color:#fff; border:none; padding:10px 22px; border-radius:8px;
    font-size:13.5px; font-weight:500; cursor:pointer; font-family:'IBM Plex Sans', sans-serif;
  }
  .btn-run:hover{background:var(--teal-strong);}
  .run-hint{font-size:12px; color:var(--slate-light);}
  .exp-resp{background:#0C1621; color:#CBD6E2;}
  .resp-status{
    display:inline-flex; align-items:center; gap:6px; font-family:'IBM Plex Mono', monospace;
    font-size:12px; padding:4px 10px; border-radius:5px; margin-bottom:14px;
  }
  .resp-status.ok{background:rgba(111,217,184,0.15); color:#6FD9B8;}
  .resp-status.pending{background:rgba(255,255,255,0.08); color:#8FA0B3;}
  pre#respbody{font-family:'IBM Plex Mono', monospace; font-size:12px; line-height:1.7; white-space:pre-wrap; margin:0; color:#CBD6E2;}
  .code-tabs{display:flex; gap:6px; margin-top:20px; border-top:1px solid rgba(255,255,255,0.08); padding-top:14px;}
  .code-tab{font-size:11px; font-family:'IBM Plex Mono', monospace; color:#8FA0B3; padding:4px 9px; border-radius:5px; cursor:default;}
  .code-tab.on{background:rgba(255,255,255,0.08); color:#fff;}

  /* ---------- dashboard page ---------- */
  .kpi-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-bottom:24px;}
  .kpi-card{background:#fff; border:1px solid var(--border); border-radius:var(--radius); padding:18px;}
  .kpi-card .lab{font-size:12px; color:var(--slate-light); font-family:'IBM Plex Mono', monospace;}
  .kpi-card .val{font-family:'Space Grotesk', sans-serif; font-size:28px; font-weight:600; color:var(--navy); margin-top:6px;}
  .kpi-card .delta{font-size:12px; color:var(--teal-strong); margin-top:4px;}

  .dash-grid{display:grid; grid-template-columns:1.4fr 1fr; gap:14px; margin-bottom:24px;}
  .panel{background:#fff; border:1px solid var(--border); border-radius:var(--radius); padding:20px;}
  .panel h3{font-size:14.5px; margin:0 0 18px; color:var(--navy);}
  .bars{display:flex; align-items:flex-end; gap:10px; height:150px;}
  .bar{flex:1; background:var(--teal); border-radius:4px 4px 0 0; position:relative;}
  .bar .bl{position:absolute; bottom:-20px; left:0; right:0; text-align:center; font-size:10px; color:var(--slate-light); font-family:'IBM Plex Mono', monospace;}

  .donut{display:flex; align-items:center; gap:20px;}
  .legend-item{display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--slate); margin-bottom:8px;}
  .sw{width:10px; height:10px; border-radius:3px;}

  table.apps{width:100%; border-collapse:collapse;}
  table.apps th{
    text-align:left; font-size:11px; color:var(--slate-light); text-transform:uppercase;
    letter-spacing:0.04em; font-family:'IBM Plex Mono', monospace; padding:0 0 10px; border-bottom:1px solid var(--border);
  }
  table.apps td{font-size:13px; padding:12px 0; border-bottom:1px solid var(--border); color:var(--ink);}
  .status-pill{font-size:11px; font-family:'IBM Plex Mono', monospace; padding:3px 9px; border-radius:20px;}
  .status-pill.active{background:var(--teal-light); color:var(--teal-strong);}
  .status-pill.sandbox{background:var(--gold-light); color:var(--gold);}
  .status-pill.revoked{background:var(--danger-light); color:var(--danger);}
  .manage-link{font-size:12px; color:var(--slate); border:1px solid var(--border); padding:5px 10px; border-radius:6px; cursor:default;}

  footer{text-align:center; padding:30px; font-size:12px; color:var(--slate-light); border-top:1px solid var(--border); margin-top:40px;}

  @media (max-width:900px){
    .hero{grid-template-columns:1fr;}
    .cat-grid{grid-template-columns:repeat(2,1fr);}
    .steps{grid-template-columns:1fr;}
    .explorer{grid-template-columns:1fr;}
    .kpi-grid{grid-template-columns:repeat(2,1fr);}
    .dash-grid{grid-template-columns:1fr;}
    .navtabs{display:none;}
  }
</style>
</head>
<body>

<div class="topnav">
  <div class="brand">
    <div class="brand-mark">AN</div>
    <div class="brand-name">ABHI <span>Nexus</span></div>
  </div>
  <div class="navtabs">
    <div class="navtab active" data-page="home">Home</div>
    <div class="navtab" data-page="catalog">API catalog</div>
    <div class="navtab" data-page="explorer">Explorer &amp; sandbox</div>
    <div class="navtab" data-page="dashboard">Dashboard</div>
  </div>
  <button class="navcta">Get API keys</button>
</div>

<!-- ============ HOME ============ -->
<div class="page active" id="page-home">
  <div class="hero">
    <div>
      <div class="eyebrow">Open API platform</div>
      <h1>Build on ABHI's rails, not around them.</h1>
      <p class="lede">One catalog for onboarding, wallets, bill payments, mobile load, transfers, cards, and acquiring. Test in a live sandbox in minutes, then go live without waiting on a bespoke integration.</p>
      <div class="hero-cta">
        <button class="btn-primary">Get API keys</button>
        <button class="btn-secondary">View documentation</button>
      </div>
    </div>
    <div class="console">
      <div class="console-head">
        <div class="dot" style="background:#E8695C"></div>
        <div class="dot" style="background:#E8C275"></div>
        <div class="dot" style="background:#6FD9B8"></div>
        <div class="label">sandbox.abhinexus.pk</div>
      </div>
      <div class="console-body" id="heroConsole"></div>
    </div>
  </div>

  <div class="section-label">Api catalog</div>
  <div class="cat-grid">
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">01</div><h3>Onboarding &amp; identity</h3><p>NADRA-backed verification, liveliness, and BVS fallback.</p></div>
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">02</div><h3>Accounts &amp; wallet</h3><p>Balance inquiry, mini-statements, tier lookup.</p></div>
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">03</div><h3>Bill payments</h3><p>1-Link/1BILL and Kuickpay with automatic failover.</p></div>
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">04</div><h3>Mobile load &amp; bundles</h3><p>Jazz direct plus Ufone, Telenor, and Zong via 1-Link.</p></div>
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">05</div><h3>Transfers</h3><p>P2P payments over Raast.</p></div>
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">06</div><h3>Cards &amp; issuance</h3><p>PayPak and sponsored-BIN issuance, controls, limits.</p></div>
    <div class="cat-card" onclick="goTo('explorer')"><div class="n">07</div><h3>QR &amp; acquiring</h3><p>Merchant QR generation and transaction status.</p></div>
    <div class="cat-card" style="background:var(--navy); border-color:var(--navy);" onclick="goTo('catalog')">
      <div class="n" style="color:#8FA0B3;">08</div>
      <h3 style="color:#fff;">See all endpoints →</h3>
      <p style="color:#CBD6E2;">Browse the full catalog with docs and code samples.</p>
    </div>
  </div>

  <div class="section-label" style="margin-top:70px;">How it works</div>
  <div class="steps">
    <div class="step"><div class="num">1</div><h3>Sandbox</h3><p>Create an account and get a client ID and secret instantly. No approval wait.</p></div>
    <div class="step"><div class="num">2</div><h3>Integrate</h3><p>Test against synthetic data in the live explorer, with sample code in four languages.</p></div>
    <div class="step"><div class="num">3</div><h3>Go live</h3><p>Sign your agreement while you build. Production keys unlock the moment it's signed.</p></div>
  </div>

  <footer>ABHI Nexus — Open API Portal · Status page · Support · Change log · Terms</footer>
</div>

<!-- ============ CATALOG ============ -->
<div class="page" id="page-catalog">
  <div class="catalog-head">
    <div>
      <h2>API catalog</h2>
      <p>Every endpoint ABHI Nexus exposes, grouped by category.</p>
    </div>
    <input class="search-bar" placeholder="Search endpoints, e.g. bill payment">
  </div>
  <div class="catalog-list" id="catalogList"></div>
</div>

<!-- ============ EXPLORER ============ -->
<div class="page" id="page-explorer">
  <div class="catalog-head">
    <div>
      <h2>Explorer &amp; sandbox</h2>
      <p>Pick an endpoint, edit the request, and run it against sandbox test data.</p>
    </div>
  </div>
  <div class="explorer">
    <div class="exp-col exp-nav" id="expNav"></div>
    <div class="exp-col exp-main">
      <h3 class="path" id="expPath"></h3>
      <p class="desc" id="expDesc"></p>
      <div class="exp-field-label">Request body</div>
      <textarea id="reqbody"></textarea>
      <div class="run-row">
        <button class="btn-run" onclick="runRequest()">Run request</button>
        <span class="run-hint">Sandbox · synthetic test data</span>
      </div>
    </div>
    <div class="exp-col exp-resp">
      <div class="resp-status pending" id="respStatus">Awaiting request</div>
      <pre id="respbody">// Click "Run request" to see a live sandbox response.</pre>
      <div class="code-tabs">
        <div class="code-tab on">cURL</div>
        <div class="code-tab">Node</div>
        <div class="code-tab">Java</div>
        <div class="code-tab">PHP</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ DASHBOARD ============ -->
<div class="page" id="page-dashboard">
  <div class="catalog-head">
    <div>
      <h2>Dashboard</h2>
      <p>Acme Fintech Ltd. · Verified partner</p>
    </div>
  </div>

  <div class="kpi-grid">
    <div class="kpi-card"><div class="lab">API calls (30d)</div><div class="val">1.24M</div><div class="delta">↑ 8.2% vs prior month</div></div>
    <div class="kpi-card"><div class="lab">Success rate</div><div class="val">98.6%</div><div class="delta">↑ 0.3 pts</div></div>
    <div class="kpi-card"><div class="lab">Avg latency</div><div class="val">212ms</div><div class="delta" style="color:var(--slate);">stable</div></div>
    <div class="kpi-card"><div class="lab">Active apps</div><div class="val">3</div><div class="delta" style="color:var(--slate);">1 in sandbox</div></div>
  </div>

  <div class="dash-grid">
    <div class="panel">
      <h3>Call volume by API — last 7 days</h3>
      <div class="bars" id="barsChart"></div>
    </div>
    <div class="panel">
      <h3>Error breakdown</h3>
      <div class="donut">
        <svg width="120" height="120" viewBox="0 0 36 36">
          <circle cx="18" cy="18" r="15.9" fill="none" stroke="#EEF1F3" stroke-width="4"></circle>
          <circle cx="18" cy="18" r="15.9" fill="none" stroke="#0F6E56" stroke-width="4" stroke-dasharray="60 40" stroke-dashoffset="25"></circle>
          <circle cx="18" cy="18" r="15.9" fill="none" stroke="#B08D2A" stroke-width="4" stroke-dasharray="25 75" stroke-dashoffset="-35"></circle>
          <circle cx="18" cy="18" r="15.9" fill="none" stroke="#B3261E" stroke-width="4" stroke-dasharray="15 85" stroke-dashoffset="-60"></circle>
        </svg>
        <div>
          <div class="legend-item"><span class="sw" style="background:#0F6E56"></span>Timeout (60%)</div>
          <div class="legend-item"><span class="sw" style="background:#B08D2A"></span>Invalid payload (25%)</div>
          <div class="legend-item"><span class="sw" style="background:#B3261E"></span>Auth error (15%)</div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel">
    <h3>Apps &amp; API keys</h3>
    <table class="apps">
      <tr><th>App name</th><th>Environment</th><th>Scopes</th><th>Status</th><th>Created</th><th></th></tr>
      <tr><td>Bill pay integration</td><td>Production</td><td class="mono">bill-payments:*</td><td><span class="status-pill active">Active</span></td><td>12 Mar 2027</td><td><span class="manage-link">Manage</span></td></tr>
      <tr><td>Load &amp; bundles app</td><td>Sandbox</td><td class="mono">mobile-load:*</td><td><span class="status-pill sandbox">Sandbox</span></td><td>02 Apr 2027</td><td><span class="manage-link">Manage</span></td></tr>
      <tr><td>Onboarding POC</td><td>Sandbox</td><td class="mono">onboarding:kyc</td><td><span class="status-pill revoked">Revoked</span></td><td>20 Jan 2027</td><td><span class="manage-link">Manage</span></td></tr>
    </table>
  </div>
</div>

<script>
const endpoints = [
  {id:"onboarding-verify", cat:"Onboarding & identity", method:"POST", path:"/v1/onboarding/verify-identity",
   desc:"Verify a new customer against NADRA records with liveliness and selfie match, falling back to BVS if NADRA is unavailable.",
   body:'{\n  "cnic": "3520112345671",\n  "selfie_ref": "sbx_selfie_88213",\n  "product_tier": "asaan_digital"\n}',
   resp:'{\n  "verification_id": "ver_9f2c1a",\n  "status": "verified",\n  "method": "nadra_liveliness",\n  "bvs_fallback_used": false,\n  "matched_score": 0.97\n}'},
  {id:"account-balance", cat:"Accounts & wallet", method:"GET", path:"/v1/accounts/{id}/balance",
   desc:"Retrieve the current balance and account tier for a wallet.",
   body:'{\n  "account_id": "acc_44210"\n}',
   resp:'{\n  "account_id": "acc_44210",\n  "tier": "abhi_digital",\n  "balance": "18450.00",\n  "currency": "PKR"\n}'},
  {id:"bill-pay", cat:"Bill payments", method:"POST", path:"/v1/bill-payments/pay",
   desc:"Pay a biller. ABHI Nexus automatically fails over between 1-Link/1BILL and Kuickpay so you never implement rail-selection logic.",
   body:'{\n  "consumer_number": "0300XXXXXXX",\n  "biller_id": "kelectric_001",\n  "amount": "3450.00"\n}',
   resp:'{\n  "transaction_id": "txn_77a12c",\n  "status": "success",\n  "rail_used": "1link_1bill",\n  "amount": "3450.00",\n  "fee": "0.00"\n}'},
  {id:"mobile-load", cat:"Mobile load & bundles", method:"POST", path:"/v1/mobile-load/topup",
   desc:"Top up a prepaid mobile balance or purchase a bundle, with a pre-review check for blocking Jazz Advance loans.",
   body:'{\n  "msisdn": "0300XXXXXXX",\n  "network": "jazz",\n  "amount": "500.00"\n}',
   resp:'{\n  "transaction_id": "txn_10ff2e",\n  "status": "success",\n  "loan_block_detected": false,\n  "network": "jazz"\n}'},
  {id:"transfer", cat:"Transfers", method:"POST", path:"/v1/transfers/raast",
   desc:"Send a P2P transfer over Raast using an IBAN or a registered mobile number.",
   body:'{\n  "to_iban": "PK36ABHI0000001234567890",\n  "amount": "2000.00",\n  "narration": "Rent"\n}',
   resp:'{\n  "transaction_id": "txn_5b8a90",\n  "status": "success",\n  "rail": "raast",\n  "settlement": "instant"\n}'},
  {id:"card-issue", cat:"Cards & issuance", method:"POST", path:"/v1/cards/issue",
   desc:"Issue a PayPak or sponsored-BIN debit card for a verified customer.",
   body:'{\n  "account_id": "acc_44210",\n  "scheme": "paypak",\n  "delivery_address_id": "addr_1120"\n}',
   resp:'{\n  "card_id": "card_a13f02",\n  "status": "issued",\n  "scheme": "paypak",\n  "eta_days": 5\n}'},
  {id:"qr-generate", cat:"QR & acquiring", method:"POST", path:"/v1/qr/generate",
   desc:"Generate a merchant QR code for in-store acceptance.",
   body:'{\n  "merchant_id": "mer_2201",\n  "amount": "1200.00"\n}',
   resp:'{\n  "qr_id": "qr_c920a1",\n  "status": "active",\n  "expires_in": 300\n}'}
];

function methodClass(m){ return m === "GET" ? "get" : "post"; }

// ---- nav ----
document.querySelectorAll(".navtab").forEach(t => {
  t.addEventListener("click", () => goTo(t.dataset.page));
});
function goTo(page){
  document.querySelectorAll(".navtab").forEach(t => t.classList.toggle("active", t.dataset.page === page));
  document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
  document.getElementById("page-" + page).classList.add("active");
}

// ---- hero rotating console ----
const heroSamples = [
  {tag:"POST /v1/bill-payments/pay", lines:[
    ["m","curl -X POST https://api.abhinexus.pk/v1/bill-payments/pay \\"],
    ["s","  -H \"Authorization: Bearer sbx_••••7f21\" \\"],
    ["s","  -d '{\"biller_id\":\"kelectric_001\",\"amount\":\"3450.00\"}'"],
    ["k","→ 200 OK  rail_used: 1link_1bill  status: success"]
  ]},
  {tag:"POST /v1/mobile-load/topup", lines:[
    ["m","curl -X POST https://api.abhinexus.pk/v1/mobile-load/topup \\"],
    ["s","  -H \"Authorization: Bearer sbx_••••7f21\" \\"],
    ["s","  -d '{\"msisdn\":\"0300XXXXXXX\",\"network\":\"jazz\",\"amount\":\"500\"}'"],
    ["k","→ 200 OK  loan_block_detected: false  status: success"]
  ]},
  {tag:"POST /v1/onboarding/verify-identity", lines:[
    ["m","curl -X POST https://api.abhinexus.pk/v1/onboarding/verify-identity \\"],
    ["s","  -H \"Authorization: Bearer sbx_••••7f21\" \\"],
    ["s","  -d '{\"cnic\":\"3520112345671\"}'"],
    ["k","→ 200 OK  method: nadra_liveliness  matched_score: 0.97"]
  ]}
];
let heroIdx = 0;
function renderHero(){
  const s = heroSamples[heroIdx];
  const el = document.getElementById("heroConsole");
  el.innerHTML = '<div class="console-tag">' + s.tag + '</div>' +
    s.lines.map(l => '<div class="console-line ' + l[0] + '">' + l[1] + '</div>').join("");
  heroIdx = (heroIdx + 1) % heroSamples.length;
}
renderHero();
setInterval(renderHero, 3200);

// ---- catalog page ----
const catalogList = document.getElementById("catalogList");
catalogList.innerHTML = endpoints.map(e => (
  '<div class="catalog-row">' +
    '<span class="method ' + methodClass(e.method) + '">' + e.method + '</span>' +
    '<div><div class="path">' + e.path + '</div><div class="desc">' + e.desc + '</div></div>' +
    '<span class="cat-tag">' + e.cat + '</span>' +
    '<span class="try-link" onclick="openInExplorer(\'' + e.id + '\')">Try it →</span>' +
  '</div>'
)).join("");

function openInExplorer(id){
  goTo("explorer");
  selectEndpoint(id);
}

// ---- explorer page ----
const cats = [...new Set(endpoints.map(e => e.cat))];
const expNav = document.getElementById("expNav");
expNav.innerHTML = cats.map(c => (
  '<div class="exp-cat">' + c + '</div>' +
  endpoints.filter(e => e.cat === c).map(e => (
    '<div class="exp-item" data-id="' + e.id + '" onclick="selectEndpoint(\'' + e.id + '\')">' +
      '<span class="m ' + methodClass(e.method) + '">' + e.method + '</span>' +
      '<span>' + e.path.replace("/v1/","").split("/").slice(0,2).join(" ") + '</span>' +
    '</div>'
  )).join("")
)).join("");

function selectEndpoint(id){
  const e = endpoints.find(x => x.id === id);
  document.querySelectorAll(".exp-item").forEach(i => i.classList.toggle("active", i.dataset.id === id));
  document.getElementById("expPath").textContent = e.method + "  " + e.path;
  document.getElementById("expDesc").textContent = e.desc;
  document.getElementById("reqbody").value = e.body;
  document.getElementById("respStatus").textContent = "Awaiting request";
  document.getElementById("respStatus").className = "resp-status pending";
  document.getElementById("respbody").textContent = "// Click \"Run request\" to see a live sandbox response.";
  window._current = e;
}
selectEndpoint(endpoints[2].id);

function runRequest(){
  const e = window._current;
  const statusEl = document.getElementById("respStatus");
  const bodyEl = document.getElementById("respbody");
  statusEl.textContent = "Sending…";
  statusEl.className = "resp-status pending";
  bodyEl.textContent = "// Waiting for sandbox response…";
  setTimeout(() => {
    statusEl.textContent = "200 OK · 214ms";
    statusEl.className = "resp-status ok";
    bodyEl.textContent = e.resp;
  }, 650);
}

// ---- dashboard bars ----
const barData = [
  {l:"Mon", v:62},{l:"Tue", v:80},{l:"Wed", v:48},{l:"Thu", v:95},
  {l:"Fri", v:70},{l:"Sat", v:40},{l:"Sun", v:55}
];
document.getElementById("barsChart").innerHTML = barData.map(b => (
  '<div class="bar" style="height:' + b.v + '%;"><span class="bl">' + b.l + '</span></div>'
)).join("");
</script>
</body>
</html>
